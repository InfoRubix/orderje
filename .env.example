# --- Firestore ---------------------------------------------------------------
# Local development: run the emulator (npm run emulators) and keep these two lines.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=demo-orderje
# Against a real Firebase project from your machine: remove FIRESTORE_EMULATOR_HOST, set
# FIREBASE_PROJECT_ID, and either run `gcloud auth application-default login` or paste a
# service-account key (JSON or base64 of the JSON) here. On Vercel set FIREBASE_SERVICE_ACCOUNT.
# FIREBASE_SERVICE_ACCOUNT=
# Real project: orderje-72758

# --- App ---------------------------------------------------------------------
# Long random string: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public URL of this app, used for QR codes and payment callbacks
APP_URL=http://localhost:3000
# Comma-separated emails allowed into /admin (Rubix staff)
SUPERADMIN_EMAILS=info@rubix.com.my
# Set to "false" to close public signup and onboard kedai manually
ALLOW_SIGNUP=true
