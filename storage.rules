rules_version = '2';

// Logos and menu photos are uploaded by the Next.js server (Admin SDK, which bypasses these
// rules) and shown through Firebase download-token URLs, which also work without any rule.
// Nothing else may read, list or write files directly from a browser.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
